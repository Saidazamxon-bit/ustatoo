# PostgreSQL (production: Neon — Vercel integratsiyasi bu ikkisini avtomatik qo'yadi)
DATABASE_URL="postgresql://ustatop:ustatop@localhost:5432/ustatop"
DATABASE_URL_UNPOOLED="postgresql://ustatop:ustatop@localhost:5432/ustatop"
# JWT imzolash kaliti — kamida 32 belgi, production da albatta o'zgartiring
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
# Sayt manzili (SEO, sitemap, canonical uchun). Vercel'da avtomatik aniqlanadi.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Lokal fayl yuklash papkasi (BLOB_READ_WRITE_TOKEN bo'lsa Vercel Blob ishlatiladi)
UPLOAD_DIR="./storage/uploads"
# To'lov rejimi: demo | live
PAYMENTS_MODE="demo"
