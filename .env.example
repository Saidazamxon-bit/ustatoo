# Ma'lumotlar bazasi (SQLite — dev; production uchun PostgreSQL URL qo'ying va schema.prisma da provider ni almashtiring)
DATABASE_URL="file:./dev.db"
# JWT imzolash kaliti — kamida 32 belgi, production da albatta o'zgartiring
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
# Sayt manzili (SEO, sitemap, canonical uchun)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Yuklangan fayllar papkasi
UPLOAD_DIR="./storage/uploads"
# To'lov rejimi: demo | live
PAYMENTS_MODE="demo"
